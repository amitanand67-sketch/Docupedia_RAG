# Everything for the Azure deployment lives in this one file.
# Copy it to .env.azure (git ignores that file), fill in section 1, then run ./deploy/azure.sh create.
# The script fills in section 3 for you. Your local .env stays as it is for laptop testing.

# === 1. Fill these in =====================================================

# New resource group for the app's resources. Keep it different from the group that holds your
# Azure OpenAI resource, so "./deploy/azure.sh delete" can never remove your models.
AZURE_RESOURCE_GROUP=rg-docupedia-app
AZURE_LOCATION=eastus2
# Short, lowercase letters and digits only; used in every resource name
APP_NAME=docupedia

# Copy these from your local .env
AZURE_OPENAI_ENDPOINT=https://docupedia.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
EMBEDDING_DIMENSIONS=1536

# === 2. How the cloud app behaves =========================================

SEARCH_BACKEND=azure
HISTORY_BACKEND=cosmos
# local = pdfplumber/python-docx on your laptop while indexing (free, handles digital files well).
# docintel = Azure Document Intelligence; set WITH_DOCINTEL=true so "create" makes one. Note: its
# free F0 tier only reads the first 2 pages of each document.
EXTRACTOR=local
WITH_DOCINTEL=false
USE_SEMANTIC_RANKER=false

# demo = anyone with the link can try it, picking a demo user (best for interviewers).
# entra = visitors must sign in with an account in your Azure directory (see "./deploy/azure.sh signin").
AUTH_MODE=demo
# With AUTH_MODE=entra: your sign-in email, to get the Analytics tab
ADMIN_USERS=

# Protects your credit on a public link: questions per visitor per hour, and per day in total
RATE_LIMIT_PER_HOUR=20
DAILY_QUESTION_LIMIT=300

# === 3. Filled in by ./deploy/azure.sh (leave empty) ======================

NAME_SUFFIX=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=docupedia
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=
COSMOS_ENDPOINT=
COSMOS_KEY=
APP_URL=
