# Copy this file to .env and fill in the values from the Azure portal.
# Only the Azure OpenAI section is required for local testing.

# --- Azure OpenAI (required) ----------------------------------------------
# Portal: your Azure OpenAI resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
# The DEPLOYMENT names you chose in Azure AI Foundry (not necessarily the model names)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
EMBEDDING_DIMENSIONS=1536

# --- Local stand-ins (switch to Azure services one at a time later) --------
# local | azure
SEARCH_BACKEND=local
# local | docintel
EXTRACTOR=local
# memory (saved to .data/history.json) | cosmos
HISTORY_BACKEND=memory
# earlier messages the model sees: 12 = the last 6 questions and their answers
HISTORY_TURNS=12
# demo | entra
AUTH_MODE=demo
# describe images with the vision model during ingestion
DESCRIBE_IMAGES=true

# --- Azure AI Search (when SEARCH_BACKEND=azure) ---------------------------
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=docupedia
USE_SEMANTIC_RANKER=false

# --- Document Intelligence (when EXTRACTOR=docintel) -----------------------
AZURE_DOCINTEL_ENDPOINT=https://YOUR-DOCINTEL.cognitiveservices.azure.com/
AZURE_DOCINTEL_API_KEY=

# --- Cosmos DB (when HISTORY_BACKEND=cosmos) -------------------------------
COSMOS_ENDPOINT=https://YOUR-COSMOS.documents.azure.com:443/
COSMOS_KEY=

# --- Application Insights (optional) ---------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
