{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run chatbot (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "jinja": true
    },
    {
      "name": "Ingest sample_docs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/ingest.py",
      "args": ["sample_docs", "--reset"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run evaluation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
